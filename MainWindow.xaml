<Window x:Class="HashtagCopier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hashtag Copier" Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#161616" BorderBrush="#333" BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="BtnMandatory" Content="Обязательная часть"
                    Margin="0,0,0,8" Padding="10" FontSize="14"
                    HorizontalContentAlignment="Center"
                    Click="CopyMandatory_Click"
                    ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                    <Button x:Name="BtnAdd" Content="Добавить франшизу"
                    Margin="0,0,0,8" Padding="10" FontSize="14"
                    HorizontalContentAlignment="Center"
                    Click="Add_Click"/>
                    <Button x:Name="BtnImportExport" Content="Импорт/Экспорт"
                            Margin="0,0,0,8" Padding="10" FontSize="14"
                            HorizontalContentAlignment="Center" Click="OpenImportExport_Click"/>
                    <Button x:Name="BtnCommunityTag" Content="Тег сообщества"
                            Margin="0,0,0,16" Padding="10" FontSize="14"
                            HorizontalContentAlignment="Center" Click="EditDefaultCommunityTag_Click"/>
                    <CheckBox x:Name="TopmostCheck"
                    Content="Поверх всех окон"
                    Foreground="White"
                    Margin="0,8,0,0"
                    FontSize="13"
                    Checked="TopmostCheck_Changed"
                    Unchecked="TopmostCheck_Changed"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="СТАТИСТИКА:" Foreground="#AAA" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="StatsBlock" Foreground="#CCC" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <Border/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="12">
            <Border DockPanel.Dock="Top" Background="#2A2A2A" CornerRadius="4"
                    BorderBrush="#444" BorderThickness="1" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="ПОИСК:" Foreground="#AAA" VerticalAlignment="Center"
                               Margin="10,0,6,0"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="White" FontSize="14" Padding="4,8"
                             TextChanged="SearchBox_TextChanged"/>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="ButtonsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
